# Dockerfile.prod — thin overlay on top of the agenoia nanobot base image.
#
# Build context: /web/po52patches/  (contains nanobot/ ... not needed here —
# only docker-customizations/ is used).
#
#   docker build -f nanobot/Dockerfile.prod -t nanobot-prod:latest .
#
# The base image provides: Python runtime, installed nanobot package,
# prebuilt WebUI, entrypoint.sh, non-root user nanobot (uid 1000).
# This overlay adds only our customizations:
#   1. patched site-packages files (from package-customizations.sh)
#   2. workspace assets (skills, plugins, bootstrap MD files)
# Secrets (config.json, .pgpass) are NEVER baked in — mounted as volumes.

ARG NANOBOT_BASE=agenoia-nanobot:latest
FROM ${NANOBOT_BASE}

# --- 1. Apply site-packages patches -----------------------------------------
# package-customizations.sh stores files relative to site-packages, so the
# same tree applies to system python (/usr/local/lib/python3.12/site-packages).
COPY docker-customizations/site-packages-patches/ /tmp/sp-patches/

RUN set -e; \
    SP="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    echo "site-packages: $SP"; \
    find /tmp/sp-patches -type f | while read -r f; do \
        rel="${f#/tmp/sp-patches/}"; \
        dest="$SP/$rel"; \
        if [ ! -f "$dest" ]; then \
            echo "PATCH VERIFY FAILED: target does not exist in base image: $dest" >&2; \
            exit 1; \
        fi; \
        mkdir -p "$(dirname "$dest")"; \
        cp "$f" "$dest"; \
        if ! cmp -s "$f" "$dest"; then \
            echo "PATCH VERIFY FAILED: copy mismatch: $dest" >&2; \
            exit 1; \
        fi; \
        echo "patched: $rel"; \
    done; \
    python3 -c "import nanobot, nanobot.config.schema, nanobot.webui.settings_routes, nanobot.agent.memory, nanobot.agent.loop" \
        || { echo "PATCH VERIFY FAILED: patched modules do not import" >&2; exit 1; }; \
    rm -rf /tmp/sp-patches

# --- 2. Workspace customizations --------------------------------------------
# Per-instance state (config.json, memory/, sessions) stays on the mounted
# volume; these are install-wide defaults.
COPY --chown=nanobot:nanobot docker-customizations/AGENTS.md    /home/nanobot/.nanobot/workspace/AGENTS.md
COPY --chown=nanobot:nanobot docker-customizations/SOUL.md      /home/nanobot/.nanobot/workspace/SOUL.md
COPY --chown=nanobot:nanobot docker-customizations/USER.md      /home/nanobot/.nanobot/workspace/USER.md
COPY --chown=nanobot:nanobot docker-customizations/HEARTBEAT.md /home/nanobot/.nanobot/workspace/HEARTBEAT.md
COPY --chown=nanobot:nanobot docker-customizations/workspace/skills/  /home/nanobot/.nanobot/workspace/skills/
COPY --chown=nanobot:nanobot docker-customizations/workspace/plugins/ /home/nanobot/.nanobot/workspace/plugins/

# Keep base image ENTRYPOINT/CMD (entrypoint.sh, CMD ["status"])
