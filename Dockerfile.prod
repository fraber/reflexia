# Dockerfile.prod — build the agenoia fork (Option B).
#
# Build context: the fork root (this repo).
#
#   docker build -f Dockerfile.prod -t agenoia-prod:latest .
#
# The base image (upstream nanobot, tag-pinned) provides: Python runtime, uv,
# system dependencies, prebuilt WebUI (nanobot/web/dist), entrypoint.sh,
# non-root user nanobot.
# This image installs the fork source into system Python. Agenoia changes are
# normal source files in the fork (config/schema.py, agent/loop.py,
# agent/memory.py, webui/settings_routes.py, agent/tools/agenoia.py) — there is
# no patch-overlay machinery and no site-packages-patches tree anymore.
# External channel plugins (nanobot-po-channel) are vendored under plugins/
# and baked into the image — nanobot loads channels via importlib entry
# points, so a plugin that only lives in the workspace volume is ignored.
#
# WebUI: the fork source ships no prebuilt nanobot/web/dist (it is normally
# built by a hatch hook requiring node). Since Agenoia makes no WebUI changes,
# we reuse the base image's prebuilt dist (stashed before install, because the
# install of the fork replaces the old nanobot package files).
#
# Secrets (config.json, .pgpass) are NEVER baked in — mounted as volumes.

ARG NANOBOT_BASE=nanobot-base:2026-11-17
FROM ${NANOBOT_BASE}

USER root

# --- 1. Install the fork into system Python ---------------------------------
COPY . /tmp/agenoia-src/

RUN set -e; \
    SP="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    echo "site-packages: $SP"; \
    # Stash the base image's prebuilt WebUI dist before the fork install.
    test -f "$SP/nanobot/web/dist/index.html" \
        || { echo "BUILD FAILED: base image has no prebuilt WebUI dist" >&2; exit 1; }; \
    cp -a "$SP/nanobot/web/dist" /tmp/webui-dist; \
    NANOBOT_SKIP_WEBUI_BUILD=1 uv pip install --system --no-cache ".[whatsapp,api]"; \
    # Bake external channel plugins (entry-point group nanobot.channels).
    # --no-deps: the plugin's only dependency (nanobot-ai>=0.2.1) is exactly
    # the fork installed in the previous line; avoid any index resolution.
    # The "api" extra pulls aiohttp, which po_openai_channel imports at
    # module level (aiohttp is in no nanobot core dep and no channel extra).
    uv pip install --system --no-cache --no-deps /tmp/agenoia-src/plugins/nanobot-po-channel; \
    SP2="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    # Reuse the base image's prebuilt WebUI (fork makes no WebUI changes).
    mkdir -p "$SP2/nanobot/web"; \
    rm -rf "$SP2/nanobot/web/dist"; \
    cp -a /tmp/webui-dist "$SP2/nanobot/web/dist"; \
    # Verify: fork actually installed, Agenoia customizations present, WebUI intact.
    python3 -c "import nanobot, nanobot.config.schema, nanobot.webui.settings_routes, nanobot.agent.memory, nanobot.agent.loop" \
        || { echo "BUILD FAILED: installed modules do not import" >&2; exit 1; }; \
    test -f "$SP2/nanobot/agent/tools/agenoia.py" \
        || { echo "BUILD FAILED: agenoia tool missing after install" >&2; exit 1; }; \
    test -f "$SP2/nanobot/web/dist/index.html" \
        || { echo "BUILD FAILED: WebUI dist missing after install" >&2; exit 1; }; \
    python3 -c "from importlib.metadata import entry_points; \
eps = [e for e in entry_points(group='nanobot.channels') if e.name == 'projop-openai']; \
assert eps, 'projop-openai entry point missing'; eps[0].load()" \
        || { echo "BUILD FAILED: nanobot-po-channel entry point not loadable" >&2; exit 1; }; \
    echo "verify OK: fork installed with agenoia customizations + po-channel plugin"; \
    rm -rf /tmp/agenoia-src /tmp/webui-dist

# --- 2. Workspace customizations --------------------------------------------
# Per-instance state (config.json, .pgpass, memory/, sessions) stays on the
# mounted volume and is populated per instance (createserver52-docker.sh);
# skills are added per instance under workspace/. Channel plugins are baked
# into the image above. Nothing else is baked into the image.
