# ---- Stage 1: Build ----
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git gcc g++ libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY . .

# Create venv and install from pyproject.toml
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/venv/bin/pip install --no-cache-dir .

# ---- Stage 1.5: Apply Customizations ----
FROM builder AS customized

# Copy site-packages patches (generated by package-customizations.sh)
COPY docker-customizations/site-packages-patches/ /tmp/sp-patches/

# Apply patches: copy each patched file over the installed copy
RUN if [ -d /tmp/sp-patches ]; then \
        find /tmp/sp-patches -name "*.py" | while read -r f; do \
            dest="/opt/venv/lib/python3.12/site-packages/${f#/tmp/sp-patches/}"; \
            mkdir -p "$(dirname "$dest")"; \
            cp "$f" "$dest"; \
        done; \
    fi

# Copy workspace customizations
COPY docker-customizations/AGENTS.md /tmp/customizations/AGENTS.md
COPY docker-customizations/SOUL.md /tmp/customizations/SOUL.md
COPY docker-customizations/USER.md /tmp/customizations/USER.md
COPY docker-customizations/HEARTBEAT.md /tmp/customizations/HEARTBEAT.md
COPY docker-customizations/workspace/skills/ /tmp/customizations/workspace/skills/
COPY docker-customizations/workspace/plugins/ /tmp/customizations/workspace/plugins/

# Install plugins as editable installs
RUN if [ -d /tmp/customizations/workspace/plugins/nanobot-po-channel ]; then \
        /opt/venv/bin/pip install -e /tmp/customizations/workspace/plugins/nanobot-po-channel/ || true; \
    fi

# ---- Stage 2: Production ----
FROM python:3.12-slim

LABEL maintainer="nanobot" \
      description="Nanobot AI Assistant with ]project-open[ integration"

WORKDIR /app

# Runtime deps (PostgreSQL client for projop SQL access)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy nanobot source (for editable-import paths, skills, etc.)
COPY --from=customized /build /app/nanobot

# Copy entrypoint
COPY --from=builder /build/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Copy customizations into the image
COPY --from=customized /tmp/customizations/AGENTS.md /home/nanobot/.nanobot/workspace/AGENTS.md
COPY --from=customized /tmp/customizations/SOUL.md /home/nanobot/.nanobot/workspace/SOUL.md
COPY --from=customized /tmp/customizations/USER.md /home/nanobot/.nanobot/workspace/USER.md
COPY --from=customized /tmp/customizations/HEARTBEAT.md /home/nanobot/.nanobot/workspace/HEARTBEAT.md
COPY --from=customized /tmp/customizations/workspace/skills/ /home/nanobot/.nanobot/workspace/skills/
COPY --from=customized /tmp/customizations/workspace/plugins/ /home/nanobot/.nanobot/workspace/plugins/

# Create non-root user
RUN useradd -m -s /bin/bash nanobot && \
    chown -R nanobot:nanobot /home/nanobot

# Expose ports
# 8765  — WebSocket channel (default Nanobot WebUI)
# 8090  — ]po[ OpenAI-compatible HTTP channel
EXPOSE 8765 8090

USER nanobot
ENV HOME=/home/nanobot

# Volumes for persistent state
VOLUME ["/home/nanobot/.nanobot"]

WORKDIR /home/nanobot

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["run"]
