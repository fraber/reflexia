[Unit]
Description=Project Open as user %I
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=forking
PIDFile=/web/%i/log/nsd.pid

ExecStartPre=/bin/rm -f /web/%i/log/nsd.pid
ExecStart=/usr/local/ns/bin/nsd -t /web/%i/etc/config.tcl -u %i -g %i &

# Nanobot docker instance (no-op unless this instance has a Nanobot
# docker-compose.yml, generated by createserver52-docker.sh)
ExecStartPost=/bin/sh -c 'test -f /web/%i/filestorage/nanobot/docker-compose.yml && docker compose -f /web/%i/filestorage/nanobot/docker-compose.yml up -d || true'
ExecStopPost=/bin/sh -c 'test -f /web/%i/filestorage/nanobot/docker-compose.yml && docker compose -f /web/%i/filestorage/nanobot/docker-compose.yml down || true'

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s 9 $MAINPID

Restart=always
KillMode=process

[Install]
WantedBy=multi-user.target

